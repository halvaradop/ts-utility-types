{
  "extends": "@halvaradop/tsconfig/nextjs",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/assets/*": ["./public/assets/*"],
      "@repo/*": ["../src/*", "../app/*"],
      "@/.source": ["./.source/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
